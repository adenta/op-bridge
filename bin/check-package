#!/usr/bin/env bash
set -euo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo"
for tool in go tar visudo; do
  command -v "$tool" >/dev/null || { echo "Required package-check tool missing: $tool" >&2; exit 1; }
done
host_os=$(go env GOHOSTOS)
host_arch=$(go env GOHOSTARCH)
case "$host_os/$host_arch" in
  linux/amd64|linux/arm64|darwin/arm64) ;;
  *) echo 'Run package checks on supported Linux or macOS arm64 hardware' >&2; exit 1 ;;
esac
archive=$(GOARCH="$(go env GOHOSTARCH)" bin/build-release check)
stage=$(mktemp -d)
trap 'rm -rf -- "$stage"; rm -f -- "$archive" "$archive.sha256"' EXIT
expected=$(awk '{print $1}' "$archive.sha256")
if command -v sha256sum >/dev/null; then
  actual=$(sha256sum "$archive" | awk '{print $1}')
else
  actual=$(shasum -a 256 "$archive" | awk '{print $1}')
fi
test "$actual" = "$expected" || { echo 'Release checksum mismatch' >&2; exit 1; }
tar -xzf "$archive" -C "$stage"
bundle="$stage/op-bridge-check-$host_os-$host_arch"
for file in op-bridge README.md LICENSE SECURITY.md ORIGIN.md docs/install.md docs/configuration.md docs/usage.md docs/migration.md deploy/desktop.json deploy/client.json deploy/owner-only.json deploy/ansible/site.yml deploy/ansible/inventory.example.yml deploy/ansible/templates/op-bridge.json.j2 skills/op-bridge/SKILL.md skills/op-bridge/agents/openai.yaml; do
  test -f "$bundle/$file" || { echo "Missing release file: $file" >&2; exit 1; }
done
test -f "$bundle/deploy/macos/com.adenta.op-bridge.session.plist" || { echo 'Missing macOS LaunchAgent' >&2; exit 1; }
test -f "$bundle/deploy/macos/Launch.command" || { echo 'Missing macOS Terminal launcher' >&2; exit 1; }
test ! -e "$bundle/deploy/ansible/inventory.local.yml" || { echo 'Private inventory in release' >&2; exit 1; }
/bin/sh -n "$bundle/deploy/macos/Launch.command"
if [[ $host_os == darwin ]]; then
  /usr/bin/plutil -lint "$bundle/deploy/macos/com.adenta.op-bridge.session.plist"
fi
test "$("$bundle/op-bridge" --version)" = 'op-bridge check'
"$bundle/op-bridge" --help >/dev/null
for example in "$bundle"/deploy/*.json; do "$bundle/op-bridge" config check "$example"; done
"$bundle/op-bridge" config sudoers "$bundle/deploy/desktop.json" > "$stage/op-bridge.sudoers"
visudo -cf "$stage/op-bridge.sudoers"
if "$bundle/op-bridge" config sudoers "$bundle/deploy/client.json" >/dev/null 2>&1; then
  echo 'Client-only package unexpectedly grants sudo' >&2; exit 1
fi
if "$bundle/op-bridge" config sudoers "$bundle/deploy/owner-only.json" >/dev/null 2>&1; then
  echo 'Owner-only package unexpectedly grants sudo' >&2; exit 1
fi
printf '%s\n' 'Package checks passed; no live files or services changed.'
