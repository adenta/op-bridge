#!/usr/bin/env bash
set -euo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo"
version=${1:-dev}
if [[ ! "$version" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  echo 'usage: bin/build-release [VERSION]' >&2
  exit 1
fi
arch=${GOARCH:-$(go env GOARCH)}
os=${GOOS:-$(go env GOOS)}
case "$os/$arch" in
  linux/amd64|linux/arm64|darwin/arm64) ;;
  *) echo 'Supported release targets: linux/amd64, linux/arm64, and darwin/arm64' >&2; exit 1 ;;
esac
name="op-bridge-$version-$os-$arch"
mkdir -p dist
stage=$(mktemp -d "$repo/dist/.stage.XXXXXXXX")
trap 'rm -rf -- "$stage"' EXIT
mkdir "$stage/$name"
CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" go build -trimpath -buildvcs=false \
  -ldflags "-s -w -X github.com/adenta/op-bridge/internal/secrets.Version=$version" \
  -o "$stage/$name/op-bridge" ./cmd/op-bridge
cp README.md LICENSE SECURITY.md ORIGIN.md "$stage/$name/"
cp -R docs skills "$stage/$name/"
# Publish explicit deployment inputs, never a machine's private local inventory.
mkdir -p "$stage/$name/deploy/ansible"
cp deploy/*.json "$stage/$name/deploy/"
cp -R deploy/macos "$stage/$name/deploy/"
cp deploy/ansible/site.yml deploy/ansible/inventory.example.yml "$stage/$name/deploy/ansible/"
cp -R deploy/ansible/templates "$stage/$name/deploy/ansible/"
tar -C "$stage" -czf "$stage/$name.tar.gz" "$name"
mv "$stage/$name.tar.gz" "dist/$name.tar.gz"
if command -v sha256sum >/dev/null; then
  (cd dist && sha256sum "$name.tar.gz" > "$name.tar.gz.sha256")
else
  (cd dist && shasum -a 256 "$name.tar.gz" > "$name.tar.gz.sha256")
fi
printf '%s\n' "$repo/dist/$name.tar.gz"
